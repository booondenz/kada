# Kada environment variables: copy this file to .env, fill in the values, then run `docker compose up -d`.
#
# One file, two consumers, and both read it from the repository root. `docker compose up -d` interpolates
# the values the Compose file marks with ${...} (POSTGRES_PASSWORD, JWT_SECRET), and running the API or the
# migration straight from this directory - `go run ./cmd/server`, `go run ./cmd/migrate` - loads the whole
# file through godotenv before config.Load() reads it.
#
# .env is ignored by git, and this file is what says which keys exist: every key below is read by
# config.Config or interpolated by docker-compose.yml, and nothing else is. An empty value is deliberate
# where a real secret is required - a placeholder that looks configured is the failure this file prevents.

# ========== Database ==========
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# The password the Compose file gives the Postgres container, and the one DATABASE_URL carries. The API does
# not read it: it connects with DATABASE_URL. Change both together, and never ship kada123.
POSTGRES_PASSWORD=kada123
# Let this process apply the schema on startup with GORM AutoMigrate. The schema is defined by the models in
# internal/domain/entity; AutoMigrate only adds missing tables, columns and indexes, never drops them.
# Set it to false when the schema is applied out of band by cmd/migrate, as in production.
DB_AUTO_MIGRATE=true

# ========== Redis ==========
# Optional. Without it the cache is skipped and the rate limiter stops refusing requests, rather than the API
# stopping (see CONTRIBUTING.md section 8.2).
REDIS_URL=redis://localhost:6379

# ========== JWT ==========
# Generate a strong random secret: openssl rand -hex 32
# A weak one is rejected outright in release mode, so a placeholder here is a service that will not start.
JWT_SECRET=
JWT_EXPIRES_IN=720h  # 30 days

# ========== Server ==========
PORT=8080
GIN_MODE=debug
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# The operator secret for /api/admin, sent as X-Admin-Secret: the console asks for it once and keeps it in
# that browser. Empty refuses everybody - a missing value must not be the thing that opens those routes.
ADMIN_SECRET=
# Where uploaded files are stored. The directory is created if missing, and must be writable by the service
# user; a directory it cannot write stops the process rather than failing on the first upload.
UPLOAD_DIR=./data/uploads

# ========== A production host ==========
# None of this is typed into the server by hand. The deploy job writes ADMIN_SECRET into
# /opt/kada/backend/.env from the GitHub repository secret with deploy/upsert-env.sh, as its first step and
# before any service is replaced; every other line in that file is left as the host has it. The key is
# optional: an empty value leaves the existing line alone, and an empty secret in the service simply refuses
# the operator routes.
