# Kada environment variables: copy this file to .env, fill in the values, then run `docker compose up -d`.
#
# One file, two consumers, and both read it from the repository root. `docker compose up -d` interpolates
# the values the Compose file marks with ${...} (POSTGRES_PASSWORD, JWT_SECRET, DEEPSEEK_API_KEY), and
# running the API or the migration straight from this directory - `go run ./cmd/server`,
# `go run ./cmd/migrate` - loads the whole file through godotenv before config.Load() reads it. There used
# to be a second copy of this file inside the module directory, which meant a setting could be documented
# in the half nobody was reading.

# ========== Database ==========
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# Let this process apply the schema on startup with GORM AutoMigrate. The schema is defined by the models in
# internal/domain/entity; AutoMigrate only adds missing tables, columns and indexes, never drops them.
# Set it to false when the schema is applied out of band by cmd/migrate, as in production.
DB_AUTO_MIGRATE=true
# The Postgres service in docker-compose.yml. Must be changed in production; do not use kada123.
POSTGRES_PASSWORD=

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== JWT ==========
# Generate a strong random secret: openssl rand -hex 32
# A weak one is rejected outright in release mode, so a placeholder here is a service that will not start.
JWT_SECRET=
JWT_EXPIRES_IN=720h  # 30 days

# ========== SMS (Alibaba Cloud) ==========
# Phone number + SMS code is the only way to sign in, so in production these four are what makes the site
# usable at all: without them it is up and nobody can log in. Leave them empty for a local setup only - real
# sending is then disabled and verification codes are printed to the API log outside release mode. Copying
# the placeholder text from an example file is worse than leaving them empty, because the API starts and
# then fails on every sign-in.
#
# The deploy job writes them from repository secrets and refuses to deploy while any of them is empty, so a
# host without them is a refused deploy rather than a site that is up and unusable. That check reads the
# file, not the secrets, so a value already configured here by hand counts as configured.
#
# Both the signature (SMS_SIGN_NAME) and the template (SMS_TEMPLATE_CODE) are the system-granted pair from
# the Aliyun PNVS ("SMS verification") console. Neither has a default: they cannot be guessed or invented,
# and a wrong pair is rejected by the provider in a way that looks like a broken account.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ========== Server ==========
PORT=8080
GIN_MODE=debug
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# The phone numbers that may stop and restore links (comma separated), checked against the number the token
# was issued for. Empty refuses everybody - a missing value must not be the thing that opens /api/admin.
# ADMIN_PHONES=13800000000

# Where uploaded files are stored. The directory is created if missing, and must be writable by the service
# user; a directory it cannot write stops the process rather than failing on the first upload.
# UPLOAD_DIR=./data/uploads

# ========== AI assistant ==========
# The assistant runs inside this process: /api/ai/* is served by this binary, so there is no second service
# to configure, no internal secret and no second database. Empty values still let the process start, and the
# failure is confined to the AI page: without the chat key every question answers with a configuration
# message, and without the embedding key the assistant answers from the model alone, with no retrieved
# context.
# DeepSeek chat model API key
DEEPSEEK_API_KEY=
# DashScope (Alibaba Cloud Bailian) embedding API key, for the knowledge base. Run
# `go run ./cmd/ai-ingest/` after changing the corpus or this model.
DASHSCOPE_API_KEY=

# Optional: the chat model, its endpoint, the answer budget, and the embedding model. The defaults are what
# the assistant ran with before, including the model name.
# AI_CHAT_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_MAX_TOKENS=8192
# AI_EMBEDDING_MODEL=text-embedding-v3

# ========== A production host ==========
# On a production host none of the secrets above are typed in by hand. The deploy job writes them into
# /opt/kada/backend/.env from GitHub repository secrets with deploy/upsert-env.sh, as its first step and
# before any service is replaced. All of them are required: a missing one fails the deployment while the
# previous build keeps serving, and names the key. The check reads the host's env files rather than the
# secrets, so a value configured there by hand also satisfies it.
