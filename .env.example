# Kada environment variables: copy this file to .env, fill in the values, then run `docker compose up -d`.
#
# One file, two consumers, and both read it from the repository root. `docker compose up -d` interpolates
# the values the Compose file marks with ${...} (POSTGRES_PASSWORD, JWT_SECRET), and
# running the API or the migration straight from this directory - `go run ./cmd/server`,
# `go run ./cmd/migrate` - loads the whole file through godotenv before config.Load() reads it. There used
# to be a second copy of this file inside the module directory, which meant a setting could be documented
# in the half nobody was reading.

# ========== Database ==========
DATABASE_URL=postgres://kada:kada123@localhost:5432/kada?sslmode=disable
# Let this process apply the schema on startup with GORM AutoMigrate. The schema is defined by the models in
# internal/domain/entity; AutoMigrate only adds missing tables, columns and indexes, never drops them.
# Set it to false when the schema is applied out of band by cmd/migrate, as in production.
DB_AUTO_MIGRATE=true
# The Postgres service in docker-compose.yml. Must be changed in production; do not use kada123.
POSTGRES_PASSWORD=

# ========== Redis ==========
REDIS_URL=redis://localhost:6379

# ========== JWT ==========
# Generate a strong random secret: openssl rand -hex 32
# A weak one is rejected outright in release mode, so a placeholder here is a service that will not start.
JWT_SECRET=
JWT_EXPIRES_IN=720h  # 30 days


# ========== Server ==========
PORT=8080
GIN_MODE=debug
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# The operator secret for /api/admin: the console asks for it once and keeps it in that browser.
# Empty refuses everybody - a missing value must not be the thing that opens the operator routes.
# ADMIN_SECRET=change-me-to-a-long-random-string

# Where uploaded files are stored. The directory is created if missing, and must be writable by the service
# user; a directory it cannot write stops the process rather than failing on the first upload.
# UPLOAD_DIR=./data/uploads

# ========== A production host ==========
# On a production host none of the secrets above are typed in by hand. The deploy job writes them into
# /opt/kada/backend/.env from GitHub repository secrets with deploy/upsert-env.sh, as its first step and
# before any service is replaced. All of them are required: a missing one fails the deployment while the
# previous build keeps serving, and names the key. The check reads the host's env files rather than the
# secrets, so a value configured there by hand also satisfies it.
