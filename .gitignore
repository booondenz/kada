# Dependencies
node_modules/
.pnpm-store/

# Go
#
# The repository root is the Go module, so `go build ./cmd/server` drops the binary next to the source
# instead of in bin/. One of those - a 47 MB Linux executable - was committed once and sat in the
# repository, which is what this list exists to prevent. The names are the commands under cmd/.
bin/
tmp/
/server
/worker
/migrate
coverage.out

# Scratch files (commit-message drafts) left behind by tooling run at the root
.gitmsg*.txt
.gm*.txt

# Tool caches.
#
# Nothing in this repository reads them, and `go env GOCACHE` / `go env GOMODCACHE` resolve outside it:
# they are here because tooling that is not allowed to write outside the workspace has to point Go
# somewhere it may write. Deleting this directory is always safe - the cost is a cold rebuild and a
# re-download of the module cache.
.cache/

# Environment
.env
.env.local
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Build output
web/dist/
web/out/

# Screenshots and reports from web/scripts/capture-theme.mjs
web/.theme-shots/

# Logs
*.log

# Generated by scripts/verify-deploy-step.test.js
scripts/.verify-deploy-out/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
